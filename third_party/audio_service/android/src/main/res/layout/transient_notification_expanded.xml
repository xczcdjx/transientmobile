<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/transient_content" android:forceDarkAllowed="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/transient_notification_background" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/transient_artwork" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:src="@drawable/transient_notification_artwork" android:contentDescription="@string/transient_artwork"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/transient_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/transient_notification_primary" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/transient_lyric" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="14sp" android:textColor="@color/transient_notification_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/transient_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/transient_notification_previous" android:contentDescription="@string/transient_previous"/>
        <ImageButton android:id="@+id/transient_play_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/transient_notification_play" android:contentDescription="@string/transient_play"/>
        <ImageButton android:id="@+id/transient_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/transient_notification_next" android:contentDescription="@string/transient_next"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/transient_progress_area" android:contentDescription="@string/transient_open_player" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <TextView android:id="@+id/transient_elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/transient_notification_secondary" android:text="00:00"/>
        <ProgressBar android:id="@+id/transient_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="4dp" android:layout_marginHorizontal="12dp" android:indeterminate="false" android:max="1000" android:progressDrawable="@drawable/transient_notification_progress" android:progressTint="@color/transient_notification_progress_fill" android:progressBackgroundTint="@color/transient_notification_progress_track"/>
        <TextView android:id="@+id/transient_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/transient_notification_secondary" android:text="00:00"/>
    </LinearLayout>
</LinearLayout>
